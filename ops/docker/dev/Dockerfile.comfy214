FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317
ARG IZO_SOURCE_SHA
RUN test -n "${IZO_SOURCE_SHA}"
LABEL org.opencontainers.image.revision="${IZO_SOURCE_SHA}" \
      org.opencontainers.image.source="spikeal8-maker/IZO_ASA"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/bridge
COPY ops/docker/dev/comfyui_bridge_server.py /opt/bridge/bridge.py
COPY backend/app/services/comfyui_native4b.py /opt/bridge/comfyui_native4b.py
USER 10001:10001
CMD ["python","/opt/bridge/bridge.py"]
