FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317
ARG IZO_SOURCE_SHA
LABEL org.opencontainers.image.revision="${IZO_SOURCE_SHA}" \
      org.opencontainers.image.source="spikeal8-maker/IZO_ASA"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --gid 10001 izo \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin izo
COPY --chown=10001:10001 ops/docker/dev/openrouter_https_proxy.py /openrouter_https_proxy.py
USER 10001:10001
CMD ["python", "/openrouter_https_proxy.py"]
