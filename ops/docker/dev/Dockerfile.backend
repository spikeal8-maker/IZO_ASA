FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317

ARG IZO_SOURCE_SHA
RUN test -n "${IZO_SOURCE_SHA}"

LABEL org.opencontainers.image.revision="${IZO_SOURCE_SHA}" \
      org.opencontainers.image.source="spikeal8-maker/IZO_ASA"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/izo/backend

WORKDIR /opt/izo/backend

RUN groupadd --gid 10001 izo \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin izo
RUN install -d -o 10001 -g 10001 /home/izo/data /home/izo/media
RUN install -d -m 0700 -o 10001 -g 10001 /home/izo/worker

COPY backend/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY --chown=10001:10001 backend/ /opt/izo/backend/

COPY --chown=10001:10001 tools/docker_shadow_provider.py tools/docker_shadow_fixture.py /opt/izo/fixtures/

USER 10001:10001

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
