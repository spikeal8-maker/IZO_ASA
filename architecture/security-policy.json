{
  "version": 3,
  "package": "STAB-SUPPLY-CHAIN-001",
  "slice": "complete-supply-chain-floor",
  "dependencyMutation": {
    "allowed": false,
    "protectedFiles": [
      "frontend/package.json",
      "frontend/package-lock.json",
      "backend/requirements.txt"
    ]
  },
  "npmAudit": {
    "workingDirectory": "frontend",
    "commands": {
      "full": [
        "npm",
        "audit",
        "--json"
      ],
      "production": [
        "npm",
        "audit",
        "--omit=dev",
        "--json"
      ]
    },
    "freshBaselineSource": "exact-head-github-ci",
    "historicalCountsAcceptedAsFreshBaseline": false,
    "requiredStatus": "AVAILABLE",
    "highCriticalPolicy": "deny-unless-exact-tracked-exception",
    "classificationValues": [
      "production",
      "dev-only"
    ],
    "severities": [
      "critical",
      "high",
      "moderate",
      "low"
    ],
    "findingFields": [
      "package",
      "severity",
      "advisoryIds",
      "range",
      "fixAvailable",
      "presentInProductionAudit",
      "runtimeOrDev"
    ],
    "vulnerabilityExitCodeIsData": true,
    "scannerUnavailableFailsRequiredGate": true
  },
  "forbiddenCommands": [
    "npm audit fix",
    "npm audit fix --force",
    "npm update"
  ],
  "baselineExceptions": [],
  "pythonAudit": {
    "scanner": {
      "name": "pip-audit",
      "version": "2.10.1"
    },
    "input": "backend/requirements.txt",
    "requiredStatus": "AVAILABLE",
    "severitySource": "scanner-only",
    "unknownSeverityRequiresReview": true,
    "baselineExceptions": []
  },
  "licenses": {
    "scanners": {
      "frontend": {
        "name": "license-checker-rseidelsohn",
        "version": "5.0.1"
      },
      "backend": {
        "name": "pip-licenses",
        "version": "5.5.5",
        "source": "license-expression"
      }
    },
    "directDependenciesOnly": true,
    "classificationValues": [
      "production",
      "dev/test",
      "unknown"
    ],
    "approvedExpressions": [
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "MIT",
      "MIT-CMU"
    ],
    "forbiddenExpressions": [],
    "unlistedExpressionClass": "needs-review",
    "reviews": [
      {
        "ecosystem": "backend",
        "package": "socksio",
        "resolvedVersion": "1.0.0",
        "license": "UNKNOWN",
        "classification": "unknown",
        "issue": "#156",
        "owner": "spikeal8-maker",
        "reason": "Fresh 2026-10-25 version-scoped review: PyPI https://pypi.org/project/socksio/1.0.0/ and its package documentation explicitly state MIT; pip-licenses 5.5.5 --from=expression reports UNKNOWN for this exact 1.0.0 pin. Review covers missing scanner metadata only, not an unknown legal license.",
        "reviewBy": "2027-01-25"
      }
    ]
  },
  "secretScan": {
    "scanner": {
      "name": "gitleaks",
      "version": "8.30.1",
      "asset": "gitleaks_8.30.1_windows_x64.zip",
      "sha256": "d29144deff3a68aa93ced33dddf84b7fdc26070add4aa0f4513094c8332afc4e"
    },
    "scope": "event-derived-git-range-base-exclusive-head-inclusive",
    "redactPercent": 100,
    "rawUnredactedArtifactAllowed": false,
    "syntheticRedactionTestRequired": true,
    "requiredStatus": "AVAILABLE",
    "findingPolicy": "deny",
    "eventRange": {
      "head": {
        "pull_request": "github.event.pull_request.head.sha",
        "push": "github.sha",
        "workflow_dispatch": "github.sha"
      },
      "base": {
        "pull_request": "github.event.pull_request.base.sha",
        "push": "github.event.before; use HEAD^ fallback when before is missing, zero, invalid, or unavailable",
        "workflow_dispatch": "HEAD^"
      },
      "validation": [
        "checked-out git HEAD must equal the resolved event HEAD",
        "resolved base must be an available commit SHA before scanning",
        "changed-scope scan range is resolved base..exact HEAD"
      ]
    }
  }
}
