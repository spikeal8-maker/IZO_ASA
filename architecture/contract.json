  ],
  "file_limits": [
    {"path": "backend/main.py", "max_lines": 19750, "protected": true, "non_growth": true, "owner": "backend-composition", "category": "backend-hotspot"},
    {"path": "frontend/src/newStudioV3.css", "max_lines": 6400, "protected": true, "non_growth": true, "owner": "frontend-studio", "category": "frontend-style-hotspot"},
    {"path": "frontend/src/newUi.tsx", "max_lines": 3950, "protected": true, "non_growth": true, "owner": "frontend-studio", "category": "frontend-ui-hotspot"},
    {"path": "frontend/src/LegacyApp.tsx", "max_lines": 3700, "protected": true, "non_growth": true, "owner": "frontend-legacy", "category": "frontend-legacy-hotspot"},
    {"path": "frontend/src/newUi.css", "max_lines": 3400, "protected": true, "non_growth": true, "owner": "frontend-studio", "category": "frontend-style-hotspot"},
    {"path": "frontend/src/index.css", "max_lines": 2650, "protected": true, "non_growth": true, "owner": "frontend-shell", "category": "frontend-style-hotspot"},
    {"path": "backend/static/feed/index.html", "max_lines": 2200, "protected": true, "non_growth": true, "owner": "feed-static", "category": "static-ui-hotspot"},
    {"path": "frontend/src/adminModels.tsx", "max_lines": 2300, "protected": true, "non_growth": true, "owner": "admin-models", "category": "frontend-admin-hotspot"},
    {"path": "backend/test_feed_v2.py", "max_lines": 2600, "protected": true, "non_growth": true, "owner": "feed-tests", "category": "test-hotspot"}
  ],
  "symbol_limits": [
    {
      "path": "backend/main.py",
      "max_top_level_functions": 725,
      "max_top_level_classes": 83,
      "max_routes": 238,
      "protected": true,
      "non_growth": true,
      "owner": "backend-composition",
      "category": "backend-hotspot"
    }
  ],
  "source_size_policy": {
    "normal_max_lines": 500,
    "soft_max_lines": 750,
    "trend_window_packages": 3,
    "trend_growth_percent": 15,
    "roots": ["backend", "frontend/src", "frontend/public", "tools"],
    "extensions": [".py", ".ts", ".tsx", ".js", ".mjs", ".css", ".html", ".ps1"],
    "classifications": [
      {"pattern": "docs/generated/**", "kind": "generated", "rationale": "Generated architecture and context evidence is owned by deterministic generators."},
      {"pattern": "backend/SYMBOL_MAP.md", "kind": "generated", "rationale": "Generated backend symbol map is owned by tools/generate_backend_map.py."},
      {"pattern": "frontend/node_modules/**", "kind": "vendor", "rationale": "Installed frontend dependencies are not handwritten repository source."},
      {"pattern": "backend/.venv/**", "kind": "vendor", "rationale": "Local Python environment is not handwritten repository source."}
    ]
  },
  "release_contract": {
    "python_version_file": ".python-version",
    "node_version_file": ".node-version",
    "edge_server": {
      "name": "caddy",
      "version": "2.11.4",
      "runtime_spec": "ops/caddy/runtime.json",
      "config": "ops/caddy/Caddyfile"
    },
    "required_files": [
      ".github/workflows/ci.yml",
      "backend/app/release_identity.py",
      "frontend/src/releaseIdentity.ts",
      "tools/build_release_manifest.py",
      "tools/check_frontend_release_identity.mjs",
      "tools/release_verification_receipt.py",
      "tools/verify.ps1",
      "tools/restart-backend.ps1",
      "tools/install-caddy.ps1",
      "tools/caddy-runtime.ps1",
      "tools/check-caddy-edge.ps1",
      "tools/start-caddy-from-active-release.ps1",
      "tools/stop-caddy.ps1",
      "tools/publish-frontend-release.ps1",
      "tools/publish-frontend-release-break-glass.ps1",
      "tools/rollback-frontend-release.ps1",
      "tools/start-production-stack.ps1",
      "ops/caddy/runtime.json",
      "ops/caddy/Caddyfile",
      "start-public.bat"
    ],
    "schema_compatibility": {
      "min_version": 1,
      "max_version": 7
    },
    "manifest_fields": [
      "manifest_version",
      "release_id",
      "git_sha",
      "dirty",
      "built_at",
      "frontend_asset_manifest_hash",
      "python_version",
      "node_version",
      "schema_compatibility",
      "frontend_asset_count"
    ],
    "known_gaps": [
      "Backend source is still loaded from the mutable checkout; REL-002 moves API slots to exact release directories.",
      "Caddy now reloads frontend roots gracefully, but the backend still lacks A/B slots and request draining; REL-002 closes that remaining release gap.",
      "Verification receipts and break-glass audit records are secret-free local integrity evidence, not cryptographically signed remote attestations; CI-001 and observability work retain independent evidence."
    ]
  }
}
