  ],
  "legacy_auth_consumers": [
    {
      "source": "backend/main.py",
      "symbol": "request_user_id",
      "operation": "header_read",
      "input": "x-onenode-user",
      "rationale": "Frozen compatibility helper; protected v2 routes must not call it."
    },
    {
      "source": "backend/main.py",
      "symbol": "request_user_id",
      "operation": "cookie_read",
      "input": "onenode_user",
      "rationale": "Frozen compatibility helper; protected v2 routes must not call it."
    },
    {
      "source": "backend/main.py",
      "symbol": "bootstrap",
      "operation": "cookie_set",
      "input": "onenode_user",
      "rationale": "Legacy Mini App compatibility output; it is not a trusted session credential."
    },
    {
      "source": "backend/main.py",
      "symbol": "web_login",
      "operation": "cookie_delete",
      "input": "onenode_user",
      "rationale": "Trusted web login deletes the obsolete compatibility cookie."
    },
    {
      "source": "backend/app/security/permissions.py",
      "symbol": "resolve_trusted_identity",
      "operation": "header_read",
      "input": "x-onenode-user",
      "rationale": "The value is read only to audit spoof attempts after trusted session resolution."
    }
  ],
  "task_registrations": [
    {
      "id": "generation-consumer",
      "call_source": "backend/app/services/generation_queue.py",
      "target": "consumer",
      "kind": "worker",
      "owner": "backend.app.services.generation_queue",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite jobs plus an in-process asyncio queue",
      "startup": "main.startup -> main.start_worker",
      "recovery": "backend.app.services.generation_recovery",
      "watchdog": "missing"
    },
    {
      "id": "bot-polling",
      "call_source": "backend/app/services/bot_workers.py",
      "target": "run_provider_polling",
      "kind": "worker",
      "owner": "backend.app.services.bot_workers",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite bot_polling_state cursor/marker per provider on BotRuntime",
      "startup": "main.startup -> start_bot_workers -> bot_workers.start_bot_polling_tasks (telegram + max)",
      "recovery": "cursor/marker resumes after process restart",
      "watchdog": "bounded retry loop; no independent supervisor"
    },
    {
      "id": "feed-video-publication",
      "call_source": "backend/main.py",
      "target": "feed_video_publication_worker",
      "kind": "worker",
      "owner": "backend.main",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite feed_publications status plus an in-process asyncio queue",
      "startup": "main.startup -> start_feed_video_publication_worker",
      "recovery": "startup requeues rows in preparing status",
      "watchdog": "missing"
    },
    {
      "id": "avatar-cache",
      "call_source": "backend/main.py",
      "target": "ensure_user_avatar_cached",
      "kind": "ephemeral",
      "owner": "backend.main",
      "role": "request-side-effect",
      "persistence": "avatar file and user metadata",
      "startup": "request path",
      "recovery": "later request may retry",
      "watchdog": "not applicable"
    },
    {
      "id": "openrouter-catalog-refresh",
      "call_source": "backend/main.py",
      "target": "refresh_openrouter_catalog",
      "kind": "ephemeral",
      "owner": "backend.main",
      "role": "admin-cache-refresh",
      "persistence": "process cache",
      "startup": "admin/models request schedules refresh",
      "recovery": "later request may retry",
      "watchdog": "single task handle"
    },
    {
      "id": "admin-notification-delivery",
      "call_source": "backend/app/services/admin_notification_delivery.py",
      "target": "run",
      "kind": "worker",
      "owner": "backend.app.services.admin_notification_delivery.AdminNotificationDeliveryWorker",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite admin_notification_delivery_outbox with lease, retry and terminal failed state",
      "startup": "main.startup -> AdminNotificationDeliveryWorker.start",
      "recovery": "expired processing leases and pending/retry rows are reclaimed after restart",
      "watchdog": "single task handle, bounded loop, last success/error timestamps exposed to trusted admin"
    },
    {
      "id": "social-telegram-delivery",
      "call_source": "backend/app/services/social_delivery.py",
      "target": "run",
      "kind": "worker",
      "owner": "backend.app.services.social_delivery.SocialDeliveryWorker",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite social_delivery_outbox with lease, retry and terminal failed state",
      "startup": "main.startup -> SocialDeliveryWorker.start",
      "recovery": "expired Telegram processing leases and pending/retry rows are reclaimed after restart",
      "watchdog": "single task handle, bounded loop, last success/error timestamps exposed to trusted admin"
    },
    {
      "id": "unverified-account-retention",
      "call_source": "backend/app/services/account_retention.py",
      "target": "run",
      "kind": "worker",
      "owner": "backend.app.services.account_retention.AccountRetentionWorker",
      "role": "production-like-current-monolith",
      "persistence": "SQLite account_verifications deadlines and terminal status",
      "startup": "main.startup -> bounded startup cleanup -> AccountRetentionWorker.start",
      "recovery": "startup and hourly bounded scans reclaim every overdue pending row idempotently",
      "watchdog": "single task handle, bounded batch, exception isolation; cleanup outcomes are security events"
    },
    {
      "id": "power-telemetry",
      "call_source": "backend/app/services/energy_telemetry.py",
      "target": "_run",
      "kind": "worker",
      "owner": "backend.app.services.energy_telemetry.PowerTelemetryWorker",
      "role": "all-dev-current-monolith",
      "persistence": "SQLite power_samples and generation_energy_usage; CyberPower database is read-only",
      "startup": "main.startup -> PowerTelemetryWorker.start",
      "recovery": "fresh two-second samples resume after process restart; completed generation summaries are idempotently reconciled",
      "watchdog": "single task handle with isolated sample failures and bounded raw-data retention"
    },
    {
      "id": "ollama-residency",
      "call_source": "backend/app/services/assistant_runtime.py",
      "target": "_run",
      "kind": "worker",
      "owner": "backend.app.services.assistant_runtime.OllamaResidencyController",
      "role": "production-like-current-monolith",
      "persistence": "Ollama selected model residency on the service-pinned RTX 4070",
      "startup": "main.startup -> start_ollama_residency_worker",
      "recovery": "request-time verification plus bounded periodic rewarm after Ollama or backend restart",
      "watchdog": "single task handle, 30-second healthy check and capped five-minute failure backoff"
    },
    {
      "id": "gallery-storage-optimization",
      "call_source": "backend/main.py",
      "target": "asyncio.to_thread:optimize_existing_gallery_storage",
      "kind": "ephemeral",
      "owner": "backend.main",
      "role": "startup-maintenance",
      "persistence": "SQLite and media files",
      "startup": "main.startup when maintenance policy allows",
      "recovery": "next startup may retry",
      "watchdog": "missing"
    },
    {
      "id": "runtime-alert",
      "call_source": "backend/main.py",
      "target": "_send_runtime_alert",
      "kind": "ephemeral",
      "owner": "backend.main",
      "role": "request-observability",
      "persistence": "external webhook only",
      "startup": "client/synthetic error path",
      "recovery": "none",
      "watchdog": "none"
    }
  ],
  "listeners": [
    {
      "id": "frontend-edge",
      "bind": "127.0.0.1",
      "port": 5173,
      "required_local": true,
      "process_names": ["caddy.exe"],
      "command_contains": ["run", "--config", "ops\\caddy\\Caddyfile"],
      "windows_service_fallback": {
        "name": "IZOCaddy",
        "arguments_contains": ["run", "--config", "C:\\IZO_ASA\\config\\Caddyfile", "--adapter", "caddyfile"]
      },
      "evidence_files": [
        "ops/caddy/Caddyfile",
        "ops/caddy/runtime.json",
        "tools/caddy-runtime.ps1",
        "tools/check-caddy-edge.ps1",
        "tools/publish-frontend-release.ps1"
      ]
    },
    {
      "id": "api",
      "bind": "127.0.0.1",
      "port": 8000,
      "required_local": true,
      "process_names": ["python.exe"],
      "command_contains": ["-m", "uvicorn", "main:app", "--port", "8000", "--no-proxy-headers"],
      "windows_service_fallback": {
        "name": "IZOBackend",
        "arguments_contains": ["-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "8000", "--no-proxy-headers"]
      },
      "evidence_files": ["tools/restart-backend.ps1", "tools/start-production-stack.ps1"]
    },
    {
      "id": "qwen-asr",
      "bind": "127.0.0.1",
      "port": 8001,
      "required_local": false,
      "process_names": ["python.exe"],
      "command_contains": ["qwen_asr_service.py", "--port", "8001"],
      "evidence_files": ["tools/start-qwen-asr.ps1", "tools/qwen_asr_service.py"]
    },
    {
      "id": "comfyui",
      "bind": "127.0.0.1",
      "port": 8188,
      "required_local": false,
      "process_names": ["python.exe"],
      "command_contains": [],
      "evidence_files": ["tools/start-production-stack.ps1"]
    },
    {
      "id": "ollama",
      "bind": "127.0.0.1",
      "port": 11434,
      "required_local": false,
      "bind_enforcement": "warn",
      "bind_rationale": "The current Ollama Desktop listener may report an IPv6 wildcard bind; keep the desired loopback target visible until OPS hardening closes the gap.",
      "process_names": ["ollama.exe"],
      "command_contains": ["serve"],
      "windows_service_fallback": {
        "name": "IZOOllama",
        "arguments_contains": ["serve"]
      },
      "evidence_files": ["tools/start-production-stack.ps1"]
    }
  ],
  "runtime_guards": {
    "full_app_process_names": ["python.exe"],
    "full_app_command_contains": ["-m", "uvicorn", "main:app"],
    "allowed_full_app_listener_ids": ["api"]
