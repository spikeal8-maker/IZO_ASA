#!/bin/sh
set -eu
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  echo "MAIN_GUARD_REPO_UNAVAILABLE" >&2
  exit 2
fi
python_cmd="${IZO_PYTHON_PATH:-python}"
"$python_cmd" "$repo_root/tools/agent_system/main_guard.py" check-local --repo-root "$repo_root"
cd "$repo_root"
exec "$python_cmd" -m tools.agent_system.enforce --repo-root "$repo_root" local
